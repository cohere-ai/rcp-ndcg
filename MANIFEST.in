# What ships in an sdist besides the package code.
include LICENSE CITATION.cff *.md requirements-constraints.txt
recursive-include src/rcp_ndcg *.py *.txt *.yaml *.json *.jsonl
recursive-include schemas *.json
recursive-include skills *.md
recursive-include examples *.py *.yaml *.json *.jsonl

prune experiments
prune site

global-exclude *.py[cod] __pycache__ .DS_Store *.log *.zip
