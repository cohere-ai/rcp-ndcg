                "$ref": "#/$defs/Wave0Hub"
              },
              {
                "$ref": "#/$defs/Wave0Gcs"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reach"
    },
    "engines": {
      "anyOf": [
        {
          "$ref": "#/$defs/Wave0Engines"
        },
        {
          "type": "null"
        }
      ],
      "default": null
