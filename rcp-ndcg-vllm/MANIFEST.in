# The sdist ships the whole package surface: the tests (with their fixtures), the exported recipe
# JSON Schema and the recipes (package data). The validation tooling moved to rcp-ndcg-test (unpublished).
include requirements-reference.txt
graft schema
graft src/rcp_ndcg_vllm/recipes
graft tests
global-exclude __pycache__ *.py[cod]
prune build
