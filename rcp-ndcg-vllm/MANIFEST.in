# The sdist ships the whole package surface: tests (with the stub engine and the fixture recipes),
# the exported JSON Schemas and the recipes (package data). Without this the published test suite
# cannot run.
include requirements-reference.txt
graft schema
graft src/rcp_ndcg_vllm/recipes
graft jobs
graft tests
global-exclude __pycache__ *.py[cod]
prune build
