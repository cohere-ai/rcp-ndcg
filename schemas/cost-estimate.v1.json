{
  "$defs": {
    "StageEstimate": {
      "description": "One stage's share of a CostEstimate.",
      "properties": {
        "calls": {
          "title": "Calls",
          "type": "integer"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "calls",
        "input_tokens",
        "output_tokens"
      ],
      "title": "StageEstimate",
      "type": "object"
    }
  },
  "$id": "https://github.com/cohere-ai/rcp-ndcg/blob/main/schemas/cost-estimate.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A projected judging pass.",
  "properties": {
    "assumptions": {
      "description": "What the numbers rest on.",
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "calls": {
      "description": "Judge calls (an upper bound: the adaptive phase can stop early).",
      "title": "Calls",
      "type": "integer"
    },
    "input_token_count": {
      "description": "``\"exact\"`` when the text was counted with the judge's tokenizer, ``\"approximate\"`` when it was estimated from characters (the judge names no tokenizer).",
      "enum": [
        "exact",
        "approximate"
      ],
      "title": "Input Token Count",
      "type": "string"
    },
    "input_tokens": {
      "description": "Prompt tokens (exact or approximate: ``input_token_count``).",
      "title": "Input Tokens",
      "type": "integer"
    },
    "output_tokens": {
      "description": "Completion tokens (approximate).",
      "title": "Output Tokens",
      "type": "integer"
    },
    "schema": {
      "const": "rcp-ndcg.cost-estimate.v1",
      "default": "rcp-ndcg.cost-estimate.v1",
      "title": "Schema",
      "type": "string"
    },
    "stages": {
      "additionalProperties": {
        "$ref": "#/$defs/StageEstimate"
      },
      "description": "Per stage.",
      "title": "Stages",
      "type": "object"
    },
    "wall_s": {
      "description": "Wall time in seconds at the judge's concurrency (approximate).",
      "title": "Wall S",
      "type": "number"
    }
  },
  "required": [
    "calls",
    "input_tokens",
    "output_tokens",
    "wall_s",
    "stages",
    "input_token_count",
    "assumptions"
  ],
  "title": "CostEstimate",
  "type": "object",
  "x-rcp-ndcg-schema": "rcp-ndcg.cost-estimate.v1"
}
