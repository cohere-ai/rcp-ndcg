{
  "$defs": {
    "JobState": {
      "description": "One job a runner was handed for the run.",
      "properties": {
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "description": "pending, running, succeeded, failed, cancelled or unknown.",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "handle",
        "status"
      ],
      "title": "JobState",
      "type": "object"
    },
    "MirrorState": {
      "description": "What a mirror last did (``run status`` shows it).",
      "properties": {
        "lag_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds since the last successful upload.",
          "title": "Lag S"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "last_upload_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Upload At"
        },
        "remote": {
          "title": "Remote",
          "type": "string"
        }
      },
      "required": [
        "remote"
      ],
      "title": "MirrorState",
      "type": "object"
    },
    "StepProgress": {
      "description": "How far a judging step has got, in judge windows.",
      "properties": {
        "done": {
          "description": "Windows judged and stored so far.",
          "title": "Done",
          "type": "integer"
        },
        "planned": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The windows the step's schedule asks at most for its pools (the tournament's adaptive phase can stop early); ``None`` until the pools and the schedule are known.",
          "title": "Planned"
        }
      },
      "required": [
        "done"
      ],
      "title": "StepProgress",
      "type": "object"
    },
    "StepState": {
      "description": "One planned step of a run: its status, time, error and, for a judging step, its progress.",
      "properties": {
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepProgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Judge windows done and planned (judging steps)."
        },
        "status": {
          "description": "pending, running, completed, partial or failed.",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "StepState",
      "type": "object"
    }
  },
  "$id": "https://github.com/cohere-ai/rcp-ndcg/blob/main/schemas/run-status.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Where a run stands: its status, every step, spend and usage, and its jobs when a runner holds it.",
  "properties": {
    "budget_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Budget Usd"
    },
    "cost_usd": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "The judge's spend so far in USD; null when the judge has no price.",
      "title": "Cost Usd"
    },
    "done": {
      "description": "Whether the status is terminal (completed, partial, failed or cancelled).",
      "title": "Done",
      "type": "boolean"
    },
    "jobs": {
      "items": {
        "$ref": "#/$defs/JobState"
      },
      "title": "Jobs",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "`<system>/<metric>@<k>` -> value of every system but the judge's own order (the full report with confidence intervals: metrics/report.json).",
      "title": "Metrics",
      "type": "object"
    },
    "mirror": {
      "anyOf": [
        {
          "$ref": "#/$defs/MirrorState"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The mirror's last upload and lag, if mirrored."
    },
    "requests": {
      "description": "Judge requests made so far.",
      "title": "Requests",
      "type": "integer"
    },
    "run_dir": {
      "title": "Run Dir",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "runner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The job runner holding the run, if any.",
      "title": "Runner"
    },
    "schema": {
      "const": "rcp-ndcg.run-status.v1",
      "type": "string"
    },
    "status": {
      "description": "submitted, running, completed, partial, failed or cancelled.",
      "title": "Status",
      "type": "string"
    },
    "steps": {
      "description": "Every planned step in run order; one not started yet is pending.",
      "items": {
        "$ref": "#/$defs/StepState"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "run_id",
    "run_dir",
    "status",
    "done",
    "steps",
    "cost_usd",
    "budget_usd",
    "requests",
    "metrics"
  ],
  "title": "RunState",
  "type": "object",
  "x-rcp-ndcg-schema": "rcp-ndcg.run-status.v1"
}
